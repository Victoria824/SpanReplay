NODE_ENV=development
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AGENT_SERVICE_URL=http://localhost:4001
RETRIEVAL_SERVICE_URL=http://localhost:4002
REPLAY_DIR=./data/replays
SPANREPLAY_REDACT_CONTENT=true
REPLAY_STORE_BACKEND=filesystem
# REPLAY_S3_BUCKET=company-spanreplay-production
# REPLAY_S3_PREFIX=replays
# REPLAY_S3_KMS_KEY_ID=alias/spanreplay-production
SPANREPLAY_CODE_VERSION=0.1.0
# Optional controls for exposed deployments. Leave empty for the local demo.
SPANREPLAY_API_KEY=
CORS_ORIGIN=http://localhost:4173
RATE_LIMIT_MAX=120
# Optional Auth0/OIDC mode. When configured, Bearer tokens replace the local API key.
# AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com/
# AUTH0_AUDIENCE=https://spanreplay-api
# AUTH0_ROLES_CLAIM=https://spanreplay.example.com/roles
# AUTH0_TENANT_CLAIM=org_id
# AUTH0_REQUIRE_TENANT=true
# Datadog overlay only. Export secrets from the shell instead of committing them.
DD_SITE=datadoghq.com
DD_ENV=local
DD_VERSION=0.1.0
# Pin to an approved digest in controlled environments.
DD_AGENT_IMAGE=gcr.io/datadoghq/agent:7
# DD_API_KEY and DD_APP_KEY must be exported from the shell.
