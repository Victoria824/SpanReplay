      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(spanreplay_ai_workflow_duration_milliseconds_bucket[5m])))", "refId": "A" }],
      "title": "Workflow p95 latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(increase(spanreplay_ai_workflow_estimated_cost_USD_total[1h]))", "refId": "A" }],
      "title": "Estimated model cost / hour",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(rate(spanreplay_ai_tool_calls_total{tool_outcome=\"success\"}[5m])) / clamp_min(sum(rate(spanreplay_ai_tool_calls_total[5m])), 0.000001)", "refId": "A" }],
      "title": "Tool success rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2 }, "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (workflow_status, failure_scenario) (rate(spanreplay_ai_workflow_runs_total[5m]))", "legendFormat": "{{workflow_status}} · {{failure_scenario}}", "refId": "A" }],
      "title": "Workflow outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
