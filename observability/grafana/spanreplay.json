      "targets": [{ "expr": "sum(rate(spanreplay_ai_workflow_runs_total{workflow_status=~\"failed|blocked\"}[5m])) / clamp_min(sum(rate(spanreplay_ai_workflow_runs_total[5m])), 0.000001)", "refId": "A" }],
      "title": "Workflow failure rate",
      "type": "stat"
